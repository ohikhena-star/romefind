PORT=4000
NODE_ENV=development
DATABASE_URL="file:./dev.db" # Or postgresql://user:password@localhost:5432/romefind for PostgreSQL
JWT_SECRET="your-jwt-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

# Google Authentication (OAuth 2.0 Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
